{
  "name": "carbide-forecasting-app",
  "version": "1.0.0",
  "private": true,
  "description": "Informationsapplikation zur Preisprognose von Wolfram-Carbide (China/EU) mit Voices-of-the-Market News und optionaler KI-Kommentierung über die Bosch Model Farm.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "package:win": "pkg server.js --config package.json --targets node22-win-x64 --output dist/CarbideMarktradar.exe"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  }
}
