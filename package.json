{
  "name": "carbide-forecasting-app",
  "version": "1.0.0",
  "private": true,
  "description": "Informationsapplikation zur Preisprognose von Wolfram-Carbide (China/EU) mit Voices-of-the-Market News und optionaler KI-Kommentierung über die Bosch Model Farm.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test",
    "diagnose:news": "node scripts/diagnose-news.js",
    "diagnose:ai": "node scripts/diagnose-ai.js",
    "diagnose:news-events": "node scripts/diagnose-news-events.js",
    "diagnose:news-lage": "node scripts/diagnose-news-lage.js",
    "backfill:news-events": "node scripts/backfill-news-events.js",
    "backfill:event-outcomes": "node scripts/backfill-event-outcomes.js",
    "diagnose:event-outcomes": "node scripts/diagnose-event-outcomes.js",
    "diagnose:fusion": "node scripts/diagnose-fusion.js",
    "package:win": "pkg server.js --config package.json --targets node22-win-x64 --output dist/CarbideMarktradar.exe"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "config/**/*"
    ]
  }
}
