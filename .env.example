# Lokaler Standard: Ollama. Diese Datei nach ".env" kopieren/umbenennen und
# den Server nach Änderungen neu starten. Dafür ist kein API-Key erforderlich.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
MAX_LLM_ARTICLES=12
OLLAMA_BATCH_SIZE=3
OLLAMA_TIMEOUT_MS=75000

# Slower CPU / Windows example:
# OLLAMA_BATCH_SIZE=1
# OLLAMA_TIMEOUT_MS=180000

# Bosch Model Farm (BMF) bleibt optional. Nur für LLM_PROVIDER=bmf erforderlich.
# Echte Werte eintragen; .env wird nicht versioniert.

# Basis-URL des BMF-Gateways OHNE Pfad-Suffix
BMF_BASE_URL=

# Persönlicher API-Key aus der Welcome-Mail – HIER SELBST eintragen, nicht im Chat teilen!
BMF_API_KEY=

# Deployment-/Modellname laut BMF-Doku
BMF_MODEL=

# API-Version des Azure-OpenAI-kompatiblen Endpoints
BMF_API_VERSION=2025-04-01-preview

# Auth-Schema laut BMF-Doku: Header "genaiplatform-farm-subscription-key: <key>"
BMF_AUTH_STYLE=subscription-key

# Port, auf dem der lokale Server läuft
PORT=3000

# Hinweis: Der Firmenproxy (HTTPS_PROXY/HTTP_PROXY) wird automatisch aus den bestehenden
# System-Umgebungsvariablen übernommen - hier muss nichts eingetragen werden.

# Optional explicit override for forecasting/pipeline.py. Without it, the server
# prefers a project-local .venv/venv and then platform Python commands.
# macOS/Linux:
#FORECAST_PYTHON=.venv/bin/python
# Windows:
#FORECAST_PYTHON=.venv\Scripts\python.exe

# Optional: Zeitlimit (ms) für den Aufruf von forecasting/pipeline.py. Standard: 120000 (2 Min).
#FORECAST_TIMEOUT_MS=120000
